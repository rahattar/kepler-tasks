#!/usr/bin/env python3
"""The oil laboratory: labsample PACKAGE_DIR TAG [TAG ...]   One order for a package in a run."""
import json, os, sys

ROOT = os.environ.get("LAB_ROOT", "/var/tmp/jf_lab")
def main(argv):
    if len(argv) < 2:
        print("usage: labsample PACKAGE_DIR TAG [TAG ...]"); return 2
    site = json.load(open(os.path.join(argv[0], "site.json")))["site"]
    book = json.load(open(os.path.join(ROOT, site + ".json")))
    tags = argv[1:]
    if len(tags) > book["budget"]:
        print("the laboratory analyses at most %d samples for this package" % book["budget"]); return 1
    for tag in tags:
        if tag not in book["analyses"]:
            print("no bearing %s on this site" % tag); return 1
    state = os.environ.get("LAB_STATE") or os.path.join("/tmp", "labsample_%d_%s" % (os.getppid(), site))
    try:
        fd = os.open(state, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    except FileExistsError:
        print("an order was already placed for this package; the laboratory takes one"); return 1
    os.write(fd, " ".join(tags).encode()); os.close(fd)
    out = ["sampled_at,nu40_cSt,nu100_cSt,rho15_kg_m3"]
    for tag in tags:
        if tag not in book["analyses"]:
            print("no bearing %s on this site" % tag); return 1
        a = book["analyses"][tag]
        out.append("%s,%.1f,%.2f,%d" % (tag, a[0], a[1], a[2]))
    print("\n".join(out)); return 0
if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
