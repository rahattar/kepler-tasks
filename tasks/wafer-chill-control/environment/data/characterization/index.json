    "time_s",
    "pressure_cmd_torr",
    "pressure_torr",
    "center_spot_C",
    "edge_spot_C",
    "plate_rtd_C",
    "tc_inner_mean_C",
    "tc_outer_mean_C",
    "tc_mass_mean_C"
  ],
