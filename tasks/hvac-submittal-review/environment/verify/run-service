#!/bin/bash
# Starts the field-verification service as the facilities user. Takes no arguments and passes no
# environment from the caller to the server. Idempotent: a running service is left as it is.
set -u
URL=http://127.0.0.1:8000
if curl -sf -o /dev/null "$URL/status"; then
    echo "field-verification service already running at $URL"
    exit 0
fi
cd /opt/verify || exit 1
setsid nohup env -i PATH=/usr/local/bin:/usr/bin:/bin python3 -I /opt/verify/server.py 8000 /var/lib/verify/state.json \
    > /var/lib/verify/server.log 2>&1 < /dev/null &
for _ in $(seq 1 50); do
    if curl -sf -o /dev/null "$URL/status"; then
        echo "field-verification service running at $URL"
        exit 0
    fi
    sleep 0.2
done
echo "field-verification service did not start" >&2
exit 1
