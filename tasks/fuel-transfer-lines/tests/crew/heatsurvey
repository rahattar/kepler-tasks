#!/usr/bin/env python3
"""heatsurvey PACKAGE_DIR PIPE [PIPE ...]

The command a program finds on the PATH where it is run and compared. It reads the site's name from the
package, leaves the order at the survey crew's desk and prints the crew's answer; the answer is worked out
by the checker, which alone can open the crew's books (tests/rerun.py, Desk). Usage and exit statuses are
those of the command the program was written against.
"""
import json
import os
import sys
import time

words = sys.argv[1:]
if len(words) < 2:
    print("usage: heatsurvey PACKAGE_DIR PIPE [PIPE ...]")
    sys.exit(2)
try:
    with open(os.path.join(words[0], "site.json")) as handle:
        site = json.load(handle)["site"]
    if not isinstance(site, str):
        raise TypeError
except (OSError, ValueError, KeyError, TypeError):
    print("%s is not a site package: it has no site.json that names the site" % words[0])
    sys.exit(2)

desk = os.environ.get("HEAT_DESK", "/run/heat-desk")
slip = "%d-%d" % (os.getpid(), time.monotonic_ns())
ask = os.path.join(desk, "asks", slip)
answer = os.path.join(desk, "answers", slip + ".txt")
try:
    with open(ask + ".part", "w") as handle:
        json.dump({"site": site, "pipes": words[1:]}, handle)
    os.rename(ask + ".part", ask + ".ask")
except OSError:
    print("the survey crew cannot be reached")
    sys.exit(3)
until = time.monotonic() + 30.0
while time.monotonic() < until:
    try:
        with open(answer) as handle:
            said = json.load(handle)
        print(said["words"])
        sys.exit(int(said["status"]))
    except (OSError, ValueError, KeyError, TypeError):
        time.sleep(0.01)
print("the survey crew cannot be reached")
sys.exit(3)
